Box = struct[T:dsize]{ptr:&'raw T};

free = cfn(p:*void);
memcpy = cfn(dst:*void, src:*void, n:usize)->*void;
no_fail_alloc = cfn(s:usize)->*void;
Box.new = fn[T](x:T)->Box[T] {
  let s=x.__size_of();
  let p=no_fail_alloc(s);
  memcpy(p, &x as *void, s);
  x.__forget();
  Box{p as &'raw _}
}
Box.__free = fn[T:dsize](b:&mut Box[T]){
(*b.ptr).__free()
free(b->ptr as *void)
}

to_unsized_box = macro (b) {
  b:Box[_];
  type b_inner = _;
  &b[0] : *mut b_inner;
  let p = b.ptr as &'raw [b_inner];
  b.__forget();
  Box{p}
}

Box.__deref = fn[T:dsize](b:&const Box[T])->&T{&*b.ptr}
Box.__deref_mut = fn[T:dsize](b:&mut Box[T])->&mut T{&*b.ptr}

some_function_that_wont_colide=fn(x:int)->Box[int] { Box::new(x) };

S=struct{x:int}
f_test1=fn(b:Box[Box[Box[Box[S]]]])->int{
	*&(b->x)
}

f_test2=fn() -> Box[[int]] {
  let b = Box::new([1,2,3,4]);
  to_unsized_box(b)
}
